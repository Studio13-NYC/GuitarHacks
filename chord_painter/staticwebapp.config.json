{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/", "rewrite": "/home.html" },
    { "route": "/index.html", "redirect": "/practice", "statusCode": 302 },
    { "route": "/practice", "rewrite": "/index.html" },
    { "route": "/api/*", "allowedRoles": ["authenticated"] }
  ],
  "globalHeaders": { "X-Content-Type-Options": "nosniff" }
}
